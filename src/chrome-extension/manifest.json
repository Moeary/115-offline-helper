{
  "manifest_version": 3,
  "name": "115 Offline Helper",
  "version": "1.4.7",
  "description": "Site-adapted magnet/ed2k submission and safe background processing for 115.com.",
  "permissions": [
    "storage",
    "cookies",
    "notifications",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.115.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "*://javbus.com/*",
    "*://*.javbus.com/*",
    "*://nyaa.si/*",
    "*://sukebei.nyaa.si/*",
    "*://mikan.tangbai.cc/*"
  ],
  "action": {
    "default_title": "115 Offline Helper",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

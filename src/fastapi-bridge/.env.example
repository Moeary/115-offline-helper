# The bridge only binds to this fixed loopback address.
PUSH115_BRIDGE_HOST=127.0.0.1
PUSH115_BRIDGE_PORT=52115

# Leave empty to create .state/bearer.token on first start.
PUSH115_BRIDGE_TOKEN=
PUSH115_BRIDGE_TOKEN_FILE=.state/bearer.token
PUSH115_BRIDGE_DB=.state/bridge.sqlite3

# Set this to the installed extension origin. Multiple origins are comma-separated.
PUSH115_BRIDGE_CORS_ORIGINS=chrome-extension://<扩展ID>

# Telegram is disabled until all required values are supplied. When polling is
# enabled, keep this static list manually copied from 115 as comma-separated
# CID=display name entries, for example 123=影视,456=动漫. The bridge never
# queries 115 directories and never receives a 115 cookie.
PUSH115_TELEGRAM_POLLING=0
PUSH115_TELEGRAM_BOT_TOKEN=
PUSH115_TELEGRAM_ALLOWED_CHAT_IDS=
PUSH115_TELEGRAM_ALLOWED_USER_IDS=
PUSH115_TELEGRAM_SAVE_PATHS=0=根目录
PUSH115_TELEGRAM_POLL_TIMEOUT=25
PUSH115_TELEGRAM_CALLBACK_TTL_SECONDS=900

# JavBus provider controls. The www redirect host is included by default.
PUSH115_JAVBUS_BASE_URL=https://javbus.com
PUSH115_JAVBUS_ALLOWED_HOSTS=javbus.com,www.javbus.com
PUSH115_JAVBUS_TIMEOUT_SECONDS=15
PUSH115_JAVBUS_MAX_RESPONSE_BYTES=2000000

# Nyaa RSS search controls. No Nyaa request is made while Telegram polling is off.
PUSH115_NYAA_BASE_URL=https://nyaa.si
PUSH115_NYAA_ALLOWED_HOSTS=nyaa.si,www.nyaa.si
PUSH115_NYAA_TIMEOUT_SECONDS=15
PUSH115_NYAA_MAX_RESPONSE_BYTES=2000000
PUSH115_NYAA_MAX_RESULTS=20
